generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  bookmarks Bookmark[]
}

model Bookmark {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
